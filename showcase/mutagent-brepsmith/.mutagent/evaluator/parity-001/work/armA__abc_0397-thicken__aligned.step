#8895 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#8896 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(5.E-04),#8893,
  'distance_accuracy_value','confusion accuracy');
#8897 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
END-ISO-10303-21;

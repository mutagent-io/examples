# CARlo — variable NAMES only. Never commit values; never bake secrets into the image.

# Backbone (spec-pinned; every provider knob is env-configurable per the competition rule).
CARLO_MODEL=gemini-3.5-flash
CARLO_TEMPERATURE=0
CARLO_THINKING_BUDGET=0          # 0 = DISABLED. Thinking is ON by default for this model (gap G-E).
CARLO_MAX_TURNS=50               # spec maxIterations = 50 (decision D10)
CARLO_VERIFY_MODE=risk           # risk | always | never  (always-verify is the deferred experiment)

# ── CARLO_MINIMAL — the ④ DIAGNOSE ablation arm ("CARlo-minimal"). DEFAULT OFF. ────────────────
# ON (=1): draft -> live-schema validate (+ in-turn retry, budget 4, then strip) -> emit. The
# feasibility/ambiguity/policy-precheck/confirmation/verify gates are all skipped, the 5 general
# behavior bullets are appended to the system prompt, and thinking flips to HIGH.
# An explicit CARLO_THINKING_BUDGET / CARLO_THINKING_LEVEL still wins in either mode.
CARLO_MINIMAL=0

# Reasoning effort for a Gemini 3 model (MINIMAL|LOW|MEDIUM|HIGH). Empty = derived: minimal mode
# sends thinkingLevel HIGH, default mode sends thinkingBudget 0. Per the Vertex thinking docs
# gemini-3.5-flash takes thinking_level (default MEDIUM); thinking_budget is the pre-Gemini-3
# parameter and sending BOTH in one request returns an error — CARlo emits exactly one.
CARLO_THINKING_LEVEL=
CARLO_TRACE_DIR=traces

# Vertex AI. gemini-3.5-flash resolved ONLY at `global` on the development project (gap G-D).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=  # or use `gcloud auth application-default login`

# Server bind
HOST=127.0.0.1
PORT=8080

# Evaluator side (simulated user + policy judge, not CARlo) for LOCAL benchmark runs.
# PREFERRED: no key — run with `--user-model-provider vertex_ai` and these two, riding gcloud ADC
# (verified live 2026-08-25):
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global
# Fallback only (AI Studio key path, `--user-model-provider gemini`):
GEMINI_API_KEY=

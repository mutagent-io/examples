{
  "name": "carlo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CARlo — harnessed gemini-3.5-flash agent for CAR-bench (IJCAI-ECAI 2026 Track 1). Implements spec_id: carlo.",
  "module": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",

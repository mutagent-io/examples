    "build": "bun build src/a2a/server.ts --target=bun --outdir=dist",
    "serve": "bun run src/a2a/server.ts",
    "cost": "bun scripts/cost-report.ts"
  },
  "dependencies": {
    "@google/genai": ">=2.18.0 <3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
